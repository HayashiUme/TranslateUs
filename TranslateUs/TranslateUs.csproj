<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Windows-only native imports (kernel32 Job Objects for the llama-server subprocess).
       Build with `-p:BuildForWindows=true` for the Windows DLL; omit it for the Android
       DLL, which runs the model in-process and must not carry Windows imports. -->
  <PropertyGroup Condition="'$(BuildForWindows)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Logo_Splash.png" />
    <EmbeddedResource Include="Resources\Stop.png" />
    <EmbeddedResource Include="Resources\Resume.png" />
    <EmbeddedResource Include="Resources\Terminology\Terminology_*.xml" />
  </ItemGroup>
</Project>
